# Платформенные артефакты (Pods, ephemeral, local.properties, keystore)
# игнорируются вложенными ios/.gitignore, macos/.gitignore, android/.gitignore.

# ───── macOS / прочее ─────
.DS_Store
*.class
*.log
*.pyc
*.swp
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ───── IDE ─────
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
# VS Code: общие настройки проекта коммитим, личные — нет
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ───── Flutter / Dart / Pub ─────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.fvm/flutter_sdk

# ───── Тесты ─────
# diff'ы упавших golden-тестов
**/failures/*.png

# ───── Сборки и символы ─────
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release
*.ipa
*.apk
*.aab

# ───── Секреты и окружения ─────
# --dart-define-from-file=env/dev.json — сами файлы не коммитим, только пример
.env
.env.*
/env/*.json
!/env/example.json

# ───── Мусор агентов / браузерных тестов ─────
.playwright-mcp/
playwright-report/
test-results/
